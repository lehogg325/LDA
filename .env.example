# Copy to .env and fill in. .env is gitignored — never commit it.

# LDA API key from https://lda.gov/api/register/ (raw key, no "Token " prefix)
LDA_API_KEY=

# Postgres (docker-compose default)
DATABASE_URL=postgresql://lda:lda@localhost:5433/lda
DATABASE_URL_TEST=postgresql://lda:lda@localhost:5433/lda_test

# Where the raw archive + manifest live (default: ./data)
LDA_DATA_DIR=./data
